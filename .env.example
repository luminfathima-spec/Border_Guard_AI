# SentinelAI — Environment Configuration Example
# Copy this file to .env and adjust variables for your local or production environment.

# ==============================================================================
# Application Settings
# ==============================================================================
APP_NAME=SentinelAI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Logging format: "text" (human readable) or "json" (structured production)
LOG_FORMAT=text
LOG_LEVEL=INFO

# ==============================================================================
# Security & Secret Handling
# IN DEVELOPMENT:
#   The default dev key is accepted with a runtime security warning.
# IN PRODUCTION / STAGING:
#   Fail-fast validation is strictly enforced on startup.
#   Startup will ABORT if SECRET_KEY is empty, matches default dev key,
#   contains placeholder words (changeme, placeholder), or is < 32 characters.
#
# Generate a cryptographically secure 32+ byte secret:
# PowerShell:   -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | % {[char]$_})
# Python:       python -c "import secrets; print(secrets.token_hex(32))"
# Bash/Linux:   openssl rand -hex 32
# ==============================================================================
SECRET_KEY=sentinel_ai_super_secret_jwt_key_sih_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Production Administrator Account (Optional - ignored in development)
# If provided in production when no admin exists, bootstraps the administrator securely.
# INITIAL_ADMIN_EMAIL=admin@sentinel.ai
# INITIAL_ADMIN_PASSWORD=ConfigureAStrongPasswordHere123!
# ALLOW_DEFAULT_CREDENTIALS_IN_PRODUCTION=False

# ==============================================================================
# Database Configuration (PostgreSQL with SQLite local dev fallback)
# Production / Docker: postgresql://sentinel:sentinel_dev_password@postgres:5432/sentinelai
# Local Windows:       postgresql://sentinel:sentinel@localhost:5432/sentinelai
# ==============================================================================
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinelai
DATABASE_CONNECT_TIMEOUT=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==============================================================================
# AI & Computer Vision Models
# ==============================================================================
YOLO_MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
PROCESS_EVERY_N_FRAMES=2
LOITERING_THRESHOLD_SECONDS=15

# ==============================================================================
# Google Gemini Intelligence Layer (Optional for local CV; required for AI reasoning)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Storage Directories (Relative to project root or absolute paths)
# ==============================================================================
DATA_DIR=data
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
EVIDENCE_DIR=data/evidence
SNAPSHOTS_DIR=data/snapshots
MAX_UPLOAD_SIZE_MB=500

# ==============================================================================
# Cross-Origin Resource Sharing (CORS)
# ==============================================================================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
