# SentinelAI — Environment Configuration

# Application
APP_NAME=SentinelAI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=sentinel_ai_super_secret_jwt_key_sih_2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinelai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# AI & Computer Vision
YOLO_MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
PROCESS_EVERY_N_FRAMES=2
LOITERING_THRESHOLD_SECONDS=15

# Google Gemini Intelligence Layer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage & Paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
EVIDENCE_DIR=data/evidence
SNAPSHOTS_DIR=data/snapshots
MAX_UPLOAD_SIZE_MB=500

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
